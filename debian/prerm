#!/bin/sh
# prerm for nearshare: remove the bytecode postinst compiled, so no
# __pycache__ directories are left behind under /usr/share/nearshare.

set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /usr/share/nearshare ]; then
            find /usr/share/nearshare -depth -type d -name __pycache__ \
                -exec rm -rf {} + 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
